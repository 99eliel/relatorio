rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // O usuário autenticado só consegue consultar o próprio registro de administrador.
    match /admins/{userId} {
      allow get: if signedIn() && request.auth.uid == userId;
      allow list: if false;
      allow create, update, delete: if false;
    }

    // Dados internos: custos, margens, observações e contratos.
    match /systems/{systemId} {
      allow read, create, update, delete: if isAdmin();
    }

    // Histórico administrativo de relatórios gerados.
    match /reports/{reportId} {
      allow read, create, update, delete: if isAdmin();
    }

    // Relatório sanitizado para compartilhamento por token.
    // Não permite listar todos os relatórios; somente abrir um documento quando o token é conhecido.
    match /publicReports/{reportId} {
      allow get: if true;
      allow list: if false;
      allow create, update, delete: if isAdmin();
    }

    // Bloqueia qualquer coleção não prevista acima.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
